+/* === CUSTOM MONITOR HOOK FOR CONTROL CHANNEL START === */
+static void
+print_control_channel_plain(const struct buffer *buf, bool from_client)
+{
+    if (buf->len <= 0) return;
+
+    // Simple heuristic: Control channel packets usually start with opcode in first byte
+    // We just dump everything that reaches the process_packet function as plain text context
+    time_t now = time(NULL);
+    struct tm *t = localtime(&now);
+    char timestamp[32];
+    strftime(timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", t);
+
+    printf("[%s] [CONTROL PLAIN] %s: Len=%d\n", timestamp, from_client ? "C->S" : "S->C", buf->len);
+    // Dump hex
+    for (int i = 0; i < buf->len; i++) { printf("%02x ", buf->data[i]); if((i+1)%16==0) printf("\n"); }
+    printf("\n--------------------------------------------------\n");
+    fflush(stdout);
+}
+/* === CUSTOM MONITOR HOOK END === */
