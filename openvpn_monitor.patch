+/* === CUSTOM MONITOR HOOK START === */
+static void
+print_hex_plain(const char *label, const uint8_t *data, int len, bool from_client)
+{
+    if (len <= 0) return;
+    
+    time_t now = time(NULL);
+    struct tm *t = localtime(&now);
+    char timestamp[32];
+    strftime(timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", t);
+
+    printf("[%s] [PLAIN DATA] %s (%s): Len=%d\n", timestamp, label, from_client ? "C->S" : "S->C", len);
+    for (int i = 0; i < len; i++) {
+        if (i > 0 && i % 16 == 0) printf("\n");
+        printf("%02x ", data[i]);
+    }
+    printf("\n--------------------------------------------------\n");
+    fflush(stdout);
+}
+/* === CUSTOM MONITOR HOOK END === */
